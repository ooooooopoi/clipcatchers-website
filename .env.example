# ---- Database -------------------------------------------------------------
# Railway: add a PostgreSQL service, then reference it here as ${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://user:password@localhost:5432/clipcatchers?schema=public"

# ---- Auth -----------------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"
# Public URL of this app (no trailing slash). Railway: https://<your-app>.up.railway.app
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Set to 1 behind Railway's proxy so Auth.js trusts the forwarded host
AUTH_TRUST_HOST=1

# ---- Email (verification + password reset) --------------------------------
# Optional. When unset, the app logs verification/reset links to the server
# console instead of emailing them, so you can still complete the flows.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Clip Catchers <no-reply@clipcatchers.com>"

# ---- Uploads --------------------------------------------------------------
# Railway: attach a volume at /data and set this to /data/uploads
UPLOAD_DIR="./uploads"
# Max upload size in megabytes
MAX_UPLOAD_MB="50"

# ---- Seed -----------------------------------------------------------------
# Credentials created by `npm run db:seed`
SEED_EMAIL="demo@clipcatchers.com"
SEED_PASSWORD="ClipCatchers!2026"

# ---- Stripe (optional, billing is Stripe-ready but works without it) ------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
