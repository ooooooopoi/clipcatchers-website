generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  ADMIN
  /// Signs in with Discord and sees their own clips and earnings, never the
  /// campaign dashboard — that is a client's view and a dead end for them.
  CLIPPER
}

enum Plan {
  STARTER
  GROWTH
  SCALE
}

enum CampaignStatus {
  PENDING
  APPROVED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum NotificationType {
  CAMPAIGN_APPROVED
  CAMPAIGN_RUNNING
  CAMPAIGN_COMPLETED
  INVOICE_PAID
  NEW_MESSAGE
  SYSTEM
}

enum FileKind {
  LOGO
  BRAND_KIT
  VIDEO
  IMAGE
  PDF
  ARCHIVE
  OTHER
}

enum TicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  company       String?
  passwordHash  String
  /// Discord snowflake, for clippers who sign in with Discord.
  ///
  /// The same id the bot keys everything on: clips.user_id, wallets.user_id
  /// and payouts are all this number, so a Discord login identifies a clipper
  /// exactly with no mapping table in between. Kept as a string because a
  /// snowflake exceeds JSON's safe integer range — see the note on
  /// export_tables in the bot's database.py, which had to learn that twice.
  discordId     String?   @unique
  image         String?
  role          Role      @default(CLIENT)
  plan          Plan      @default(STARTER)
  planRenewsAt  DateTime?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  settings       Settings?
  campaigns      Campaign[]
  invoices       Invoice[]
  notifications  Notification[]
  files          FileAsset[]
  tickets        SupportTicket[]
  ticketMessages TicketMessage[]
  paymentMethods PaymentMethod[]
  tokens         VerificationToken[]

  @@index([email])
}

model Settings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  emailCampaignUpdates Boolean  @default(true)
  emailInvoices        Boolean  @default(true)
  emailProductUpdates  Boolean  @default(false)
  emailMarketing       Boolean  @default(false)
  theme                String   @default("dark")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String    @id @default(cuid())
  token     String    @unique
  type      TokenType
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

/// Read-only mirror of the Discord bot's tables, pushed on each sync so the
/// team view can show clips, clippers, accounts and invites — none of which
/// exist as first-class records here.
model BotSnapshot {
  id        String   @id @default("latest")
  data      Json
  updatedAt DateTime @updatedAt
}

model Campaign {
  id             String         @id @default(cuid())
  userId         String
  // Set when the campaign is mirrored from the Discord bot; the bot's own
  // campaign id. Null for campaigns created here in the dashboard.
  externalId     String?        @unique
  name           String
  brandName      String
  brandLogoUrl   String?
  website        String?
  discord        String?
  description    String?
  goal           String?
  notes          String?
  status         CampaignStatus @default(PENDING)
  budgetCents    Int            @default(0)
  spentCents     Int            @default(0)
  totalViews     Int            @default(0)
  estimatedReach Int            @default(0)
  /// Approved clips delivered on this campaign, mirrored from the bot.
  clipCount      Int            @default(0)
  platforms      String[]       @default([])
  startDate      DateTime?
  endDate        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics CampaignMetric[]
  clips   CampaignClip[]
  files   FileAsset[]

  @@index([userId, status])
  @@index([createdAt])
}

model CampaignMetric {
  id         String   @id @default(cuid())
  campaignId String
  date       DateTime
  views      Int      @default(0)
  reach      Int      @default(0)
  spendCents Int      @default(0)
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
  @@index([date])
}

/// An individual approved clip, mirrored from the bot so clients can open the
/// post itself rather than take the view count on trust.
model CampaignClip {
  id         String   @id @default(cuid())
  campaignId String
  /// The bot's clip id, so re-syncs update rather than duplicate.
  externalId String
  url        String
  platform   String   @default("")
  handle     String   @default("")
  views      Int      @default(0)
  /// The canonical tiktok.com/@user/video/<id> form of `url`.
  ///
  /// ~91% of submitted links are vt.tiktok.com short links, which TikTok's
  /// oEmbed rejects outright. Resolving one costs a redirect round trip of
  /// several seconds, so it happens once in a background job and is kept.
  canonicalUrl String?
  /// oEmbed thumbnail, for the public clips wall.
  ///
  /// TikTok serves these from a *-sign CDN host: the URL carries a signature
  /// and stops resolving once it lapses. This is a cache to be refreshed, not
  /// a permanent address — `thumbnailAt` is what lets a refresh find the
  /// stale ones.
  thumbnailUrl String?
  thumbnailAt  DateTime?
  /// The post's own caption, as oEmbed reports it.
  ///
  /// Stored so the clips wall can keep itself to English posts. Kept as text
  /// rather than a decided language flag: detection on a short, hashtag-heavy
  /// caption is a judgement call, and storing the judgement instead of the
  /// evidence would mean re-resolving every clip to change your mind.
  caption      String?
  /// Why resolution last failed, so a job doesn't retry the hopeless forever.
  /// Photo posts are the common case: oEmbed serves /video/, not /photo/.
  resolveError String?
  /// Hand-picked position on the homepage clips belt; null means not picked.
  ///
  /// The belt was "top by views", which on this library means mostly French,
  /// Portuguese and Indonesian posts — the language is burned into the video
  /// frame where no caption test can see it. A shop window is curated, not
  /// ranked, so when any clip carries a rank the belt shows exactly those in
  /// that order and ignores views entirely.
  ///
  /// Survives a re-sync: the ingest upsert names its columns and this is not
  /// among them. It does not survive the clip being unapproved, which prunes
  /// the row — the belt's MINIMUM guard covers that.
  featuredRank Int?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, externalId])
  @@index([campaignId, views])
  /// The wall reads "highest views that already have a thumbnail".
  @@index([thumbnailUrl, views])
}

model Invoice {
  id              String        @id @default(cuid())
  userId          String
  number          String        @unique
  description     String
  amountCents     Int
  currency        String        @default("usd")
  status          InvoiceStatus @default(OPEN)
  issuedAt        DateTime      @default(now())
  dueAt           DateTime?
  paidAt          DateTime?
  stripeInvoiceId String?
  hostedUrl       String?
  createdAt       DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model PaymentMethod {
  id                    String   @id @default(cuid())
  userId                String
  brand                 String
  last4                 String
  expMonth              Int
  expYear               Int
  isDefault             Boolean  @default(false)
  stripePaymentMethodId String?
  createdAt             DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model FileAsset {
  id         String   @id @default(cuid())
  userId     String
  campaignId String?
  ticketId   String?
  name       String
  storageKey String
  mimeType   String
  sizeBytes  Int
  kind       FileKind @default(OTHER)
  createdAt  DateTime @default(now())

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  ticket   SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([userId, kind])
  @@index([campaignId])
}

model SupportTicket {
  id        String         @id @default(cuid())
  userId    String
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    TicketMessage[]
  attachments FileAsset[]

  @@index([userId, status])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  authorId  String
  body      String
  fromStaff Boolean  @default(false)
  createdAt DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}
